<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The bridge isn't sandboxed: it launches xcrun mcpbridge.

	     Shares the port and token with Pico. A group. identifier is registered, so the provisioning
	     profile must list it. With automatic signing, Xcode registers the group and creates the
	     profiles; see README.md, Release. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.starlingprotocol.pico</string>
	</array>
</dict>
</plist>
